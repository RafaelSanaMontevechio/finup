# Firebase Admin SDK (service account) — usado nas Route Handlers para
# acessar o Firestore e verificar/criar sessões de autenticação.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Web API Key do projeto Firebase (Configurações do projeto > Geral).
# Não é secreta — é a mesma chave usada por qualquer app cliente do
# Firebase — mas é necessária aqui porque o login (e-mail/senha) roda via
# API REST do Identity Toolkit, no servidor, em vez do SDK do navegador.
FIREBASE_WEB_API_KEY=

NODE_ENV=development
